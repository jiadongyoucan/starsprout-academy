# ===== 星芽学堂 运行配置（复制为 .env 后按需修改） =====
PORT=8080
HOST=0.0.0.0
# 数据目录（SQLite、上传照片、密钥都会落在这里）
DATA_DIR=./data
# 生产环境必须设置为随机长字符串；留空则自动生成并保存到 DATA_DIR/secret.key
APP_SECRET=
# 对外访问地址，用于生成配对/推送说明
PUBLIC_URL=http://localhost:8080
# 首次初始化令牌：远程/Docker 部署必填；本机初始化可留空
SETUP_TOKEN=
# 演示数据（首次启动写入体系化课程、示例家庭与演示账号）
# 默认关闭；本机演示可用 ./scripts/start.sh --demo，或 docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
SEED_DEMO=false
# 显式演示模式：在登录页展示演示账号（对外服务必须 false）
DEMO_MODE=false

# ===== AI 供应商（OpenAI-compatible，可选）=====
# 不配置也能完整使用：AI 会降级为本地规则引擎（可创建计划 / 生成课程草案）
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
# 备选：AI_FALLBACK_MODEL=deepseek-reasoner
# 沙箱默认关闭；仅在可信环境显式开启（子进程 + 权限模型隔离，但仍非虚拟机级）
ENABLE_SANDBOX=false

# ===== 安全 =====
# 连接器允许访问的域名白名单，逗号分隔；留空则只允许内置演示连接器
CONNECTOR_ALLOWED_HOSTS=
# 单次上传照片上限（字节）
MAX_SNAPSHOT_BYTES=2500000
# 照片保留天数（自动清理）
SNAPSHOT_RETENTION_DAYS=30
# 可选：HTTPS（摄像头/PWA 需要安全上下文）
# TLS_CERT=./data/certs/cert.pem
# TLS_KEY=./data/certs/key.pem
